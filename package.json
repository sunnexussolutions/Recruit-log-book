{
  "name": "recruit-logbook",
  "version": "1.0.0",
  "description": "Recruit Logbook system with Neon Serverless Postgres Integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:init": "node scripts/init-db.js",
    "generate:assets": "node scripts/generate-assets.js",
    "build": "node scripts/generate-assets.js && node scripts/build-www.js",
    "build:apk": "cmd /c \"cd android && gradlew assembleDebug\"",
    "cap:build": "node scripts/generate-assets.js && node scripts/build-www.js && npx cap sync",
    "cap:android": "node scripts/generate-assets.js && node scripts/build-www.js && npx cap open android",
    "cap:ios": "node scripts/generate-assets.js && node scripts/build-www.js && npx cap open ios",
    "cap:sync": "npx cap sync"
  },
  "keywords": [
    "neon",
    "postgres",
    "express",
    "recruit-logbook"
  ],
  "author": "Sun Nexus Solutions",
  "license": "MIT",
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@neondatabase/serverless": "^0.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "fs-extra": "^11.4.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "nodemon": "^3.1.0",
    "sharp": "^0.35.3"
  }
}
